# Block Forge — local dev (PC par rankings file mein save)
PORT=8097
NODE_ENV=development

# Max players per board (default 5000)
LB_MAX_ENTRIES=5000

# --- Cloud production (Render dashboard mein set karo, PC par mat chhodna) ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (service_role — sirf server par)

# --- Android Play Store build (config/api-url.txt bhi use hoti hai) ---
# BF_API_URL=https://your-app.onrender.com
